# =============================================================================
# Thai Commercial Bank Platform - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the actual values.
# Never commit .env files to version control.

# ----- Database -----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=thai_bank
DB_USER=postgres
DB_PASSWORD=postgres

# ----- Bank Identity -----
BANK_BIC_CODE=THBKTHBX
BANK_CODE=123
BANK_NAME_TH=ธนาคารพาณิชย์ไทย
BANK_NAME_EN=Thai Commercial Bank
BANK_COUNTRY=TH

# ----- Card Encryption -----
# 32-byte key for AES-256-CBC card number encryption
CARD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# ----- BOT (Bank of Thailand) Integration -----
BOT_API_URL=https://bot-api.example.com
BOT_API_KEY=
BOT_REPORTING_THRESHOLD_THB=200000
BOT_SENDER_BIC=THBKTHBX

# ----- PromptPay / ITMX -----
PROMPTPAY_API_URL=https://promptpay-api.example.com
PROMPTPAY_API_KEY=
ITMX_API_URL=https://itmx-api.example.com
ITMX_API_KEY=
BAHTNET_API_URL=https://bahtnet-api.example.com
BAHTNET_API_KEY=

# ----- FX Rate Providers -----
FX_RATE_PROVIDER=internal
FX_API_URL=
FX_API_KEY=

# ----- Application -----
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# ----- Authentication -----
JWT_SECRET=change-me-to-a-secure-random-string
SESSION_SECRET=change-me-to-another-secure-random-string
SESSION_TTL_HOURS=24

# ----- CORS -----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ----- Rate Limiting -----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
